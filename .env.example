# 复制为 .env 后按需修改。注意：.env 已在 .gitignore 中，不要提交任何密钥。

# HTTP 服务端口（默认 5173）
PORT=5173

# 监听地址。默认 0.0.0.0（便于云托管沙箱反向代理）。
# 若只在本机使用、不希望暴露到局域网，可改为 127.0.0.1。
HOST=0.0.0.0

# ────────────────────────────────────────────────────────────────
# 以下为「未来接入真实数据源」的预留位，当前实现不读取这些变量。
# 接入时请参照 src/dataset.js 的 loadDataset()。
# ────────────────────────────────────────────────────────────────
# FUYAO_API_BASE=https://fuyao.aicubes.cn
# FUYAO_API_KEY=
# IFIND_MCP_ENDPOINT=
# IFIND_MCP_TOKEN=
