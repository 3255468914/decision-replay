# 复制为 .env 后按需修改。注意：.env 已在 .gitignore 中，不要提交任何密钥。
# 本文件是模板，里面的值都是占位符 / 默认值，**不含任何密钥**，可以安全地进仓库。

# HTTP 服务端口（默认 5173）
PORT=5173

# 监听地址。默认 0.0.0.0（便于云托管沙箱反向代理）。
# 若只在本机使用、不希望暴露到局域网，可改为 127.0.0.1。
HOST=0.0.0.0

# 默认数据源：fixture（构造数据集）| real（扶摇真实数据快照）
# 两者都已随仓库提供（data/ 与 data/real/），因此**不填也能完整跑起来**。
# 也可在页面顶部的「数据源」下拉里临时切换，或用 ?source=real 覆盖单个请求。
DATA_SOURCE=fixture

# ────────────────────────────────────────────────────────────────
# 扶摇金融数据 API —— 仅在**重新拉取**数据时需要（npm run fetch:fuyao）。
# 已落盘的 data/real/ 快照不含密钥，正常运行产品、跑测试都不需要填这里。
# 读取位置：src/adapters/fuyao.js
# ────────────────────────────────────────────────────────────────
FUYAO_API_BASE=https://fuyao.aicubes.cn
FUYAO_API_KEY=

# ────────────────────────────────────────────────────────────────
# 可选：固定构建 / 生成时刻，让产物完全可复现。
# 不填时默认取数据快照自带的 generatedAt（见 scripts/build-standalone.js）。
# 例：SOURCE_DATE_EPOCH=1735632000
# ────────────────────────────────────────────────────────────────
# SOURCE_DATE_EPOCH=

# ────────────────────────────────────────────────────────────────
# iFinD MCP —— 尚未接入，仅预留（当前实现不读取这两个变量）
# ────────────────────────────────────────────────────────────────
# IFIND_MCP_ENDPOINT=
# IFIND_MCP_TOKEN=
